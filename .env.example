# CPCB / data.gov.in official dataset configuration (server only)
DATA_GOV_API_KEY=
DATA_GOV_RESOURCE_ID=3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69

# OpenAQ v3 supplementary measurements (server only)
OPENAQ_API_KEY=

# Gemini Interactions API (server only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Cloudflare Workers AI (server only; primary hosted inference provider)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# OpenRouter server-side fallback; openrouter/free selects a currently available free chat model
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Optional local Ollama fallback (development only; disabled by default)
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# Public base URL used for canonical links
NEXT_PUBLIC_APP_URL=http://localhost:3000
